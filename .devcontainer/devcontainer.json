{
  "name": "Teiko Technical - Python 3.10",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.10-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "files/streamlit_dashboard.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r files/requirements.txt && echo '✅ Dependencies installed'",
  "postAttachCommand": {
    "server": "streamlit run files/streamlit_dashboard.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
