{
  "name": "Teiko Technical - Python 3.10",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.10-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": "false",
      "installGradle": "false"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "files/streamlit_dashboard.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r files/requirements.txt && (which nextflow || (curl -fsSL https://get.nextflow.io | bash && sudo mv nextflow /usr/local/bin/)) && echo '✅ Dependencies and Nextflow installed'",
  "postAttachCommand": {
    "server": "streamlit run files/streamlit_dashboard.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
